# Suppress dotenv logs and tips
DOTENV_CONFIG_QUIET=true

# Database config
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
DATABASE_NAME=saigondi

# Application config
APP_HOST=localhost
APP_PORT=5000
BUILD_MODE=development

# JWT config
JWT_SECRET=your_jwt_secret_key_here_at_least_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here_at_least_32_characters_long

# Nodemailer Email config (for sending emails)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Twilio SMS config
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
TWILIO_MESSAGING_SERVICE_SID=your_twilio_messaging_service_sid

# Cloudinary Media upload config
CLOUD_NAME=your_cloudinary_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret

# Facebook OAuth login config
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_CALLBACK=http://localhost:5000/api/v1/auth/facebook/callback

# Google OAuth login config
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK=http://localhost:5000/api/v1/auth/google/callback

# Client URL (Frontend address)
CLIENT_URL=http://localhost:3000
